# Local-only development credentials. Copy to .env (git-ignored) and adjust if needed.
# These values are NOT secrets: they only protect the throwaway local containers.

WAREHOUSE_USER=retail
WAREHOUSE_PASSWORD=retail_local_pw
WAREHOUSE_DB=retail
# Host-side settings used by `retail-pipeline load` and scripts/metabase_setup.py.
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5433

# Metabase admin account created on first start by scripts/metabase_setup.py (local only).
MB_ADMIN_EMAIL=admin@example.com
MB_ADMIN_PASSWORD=ChangeMe-Local-123!
MB_URL=http://localhost:3000

# Text-to-SQL assistant (retail-pipeline ask / eval-assistant).
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
